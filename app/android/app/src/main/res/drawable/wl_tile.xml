<?xml version="1.0" encoding="utf-8"?>
<!-- A button on the glass: soft fill, thin edge, highlights when pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="20dp" /><solid android:color="#55FFB547" /></shape></item>
    <item><shape android:shape="rectangle"><corners android:radius="20dp" /><solid android:color="@color/w_pill" /><stroke android:width="1dp" android:color="@color/w_btn_edge" /></shape></item>
</selector>
