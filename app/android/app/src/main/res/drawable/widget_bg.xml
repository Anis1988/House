<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass panel with a light top edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="@color/w_bg_top" android:endColor="@color/w_bg_bottom" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="@color/w_shine" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.3" />
            <stroke android:width="1dp" android:color="@color/w_edge" />
        </shape>
    </item>
</layer-list>