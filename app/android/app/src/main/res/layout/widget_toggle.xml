<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wl_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wl_round" android:orientation="vertical" android:gravity="center" android:padding="3dp">
    <FrameLayout android:layout_width="34dp" android:layout_height="34dp">
        <ImageView android:id="@+id/wl_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wl_badge_off" />
        <ImageView android:id="@+id/wl_icon" android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:src="@drawable/wl_bulb" />
    </FrameLayout>
    <TextView android:id="@+id/wl_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="11.5sp" android:textStyle="bold" />
    <TextView android:id="@+id/wl_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/w_fg_muted" android:textSize="10.5sp" />
</LinearLayout>
