<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi widget: internet up/down, last speed test, who is home -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ww_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:id="@+id/ww_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="4dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wl_wifi" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Wi-Fi" android:textColor="@color/w_fg" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/ww_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg_muted" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ww_tiles" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="52dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/ww_t0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wl_tile" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <TextView android:id="@+id/ww_b0" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_s0" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg_muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ww_t1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wl_tile" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <TextView android:id="@+id/ww_b1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_s1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg_muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ww_t2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wl_tile" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <TextView android:id="@+id/ww_b2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_s2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg_muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ww_people" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
        <LinearLayout android:id="@+id/ww_p0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
            <ImageView android:id="@+id/ww_pd0" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/wl_dot_off" />
            <TextView android:id="@+id/ww_pn0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_ps0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg_muted" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ww_p1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
            <ImageView android:id="@+id/ww_pd1" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/wl_dot_off" />
            <TextView android:id="@+id/ww_pn1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_ps1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg_muted" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ww_p2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
            <ImageView android:id="@+id/ww_pd2" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/wl_dot_off" />
            <TextView android:id="@+id/ww_pn2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_ps2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg_muted" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ww_p3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
            <ImageView android:id="@+id/ww_pd3" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/wl_dot_off" />
            <TextView android:id="@+id/ww_pn3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_ps3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg_muted" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
