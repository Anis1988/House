<?xml version="1.0" encoding="utf-8"?>
<!-- The paired PC: on/off, Sleep, Lock, Shut down, or Turn on -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wp_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:id="@+id/wp_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="6dp">
        <ImageView android:id="@+id/wp_dot" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/wl_dot_off" />
        <TextView android:id="@+id/wp_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="PC" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/wp_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg_muted" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wp_on" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="44dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/wp_sleep" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wl_tile" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wl_moon" android:tint="@color/w_fg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Sleep" android:textColor="@color/w_fg" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/wp_lock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wl_tile" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wl_lock" android:tint="@color/w_fg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Lock" android:textColor="@color/w_fg" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/wp_off" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wl_tile" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wl_power" android:tint="@color/w_fg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Shut down" android:textColor="@color/w_fg" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/wp_wake" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="44dp" android:orientation="horizontal" android:visibility="gone">
        <LinearLayout android:id="@+id/wp_turnon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wl_tile" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/wl_power" android:tint="@color/w_fg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Turn on" android:textColor="@color/w_fg" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
