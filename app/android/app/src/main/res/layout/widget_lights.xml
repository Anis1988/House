<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen lights: name + how many are on, and All on / All off -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Tap the title to open the app -->
    <LinearLayout
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lights"
            android:textColor="@color/w_fg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Tap a button"
            android:textColor="@color/w_fg_muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_on"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_on"
            android:gravity="center"
            android:text="All on"
            android:textColor="@color/w_on"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_off"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_off"
            android:gravity="center"
            android:text="All off"
            android:textColor="@color/w_fg"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
