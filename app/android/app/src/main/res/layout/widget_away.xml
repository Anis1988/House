<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wl_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:id="@+id/wl_vac" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:background="@drawable/wl_tile" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
        <ImageView android:id="@+id/wl_vac_i" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/wl_plane" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vacation mode" android:textColor="@color/w_fg" android:textSize="13.5sp" android:textStyle="bold" />
            <TextView android:id="@+id/wl_vac_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg_muted" android:textSize="11.5sp" />
        </LinearLayout>
        <TextView android:id="@+id/wl_vac_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg_muted" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wl_bed" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:background="@drawable/wl_tile" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
        <ImageView android:id="@+id/wl_bed_i" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/wl_moon" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bedtime" android:textColor="@color/w_fg" android:textSize="13.5sp" android:textStyle="bold" />
            <TextView android:id="@+id/wl_bed_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_fg_muted" android:textSize="11.5sp" />
        </LinearLayout>
        <TextView android:id="@+id/wl_bed_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_fg_muted" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
